<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for Night mode. -->
    <!-- تعديل جراحي: تغيير الأب إلى Theme.AppCompat لضمان التوافق ومنع الانهيار عند الفتح في وضع الليل -->
    <style name="Base.Theme.AlQuranKarim" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/cosmic_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- إجبار الأزرار على استخدام تصميم Material -->
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button</item>
    </style>

    <style name="Theme.AlQuranKarim" parent="Base.Theme.AlQuranKarim">
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>

    <!-- Splash Screen Theme for Night mode -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cosmic_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.AlQuranKarim</item>
    </style>
</resources>
